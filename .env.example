# Netlify Functions 환경변수로만 설정. 실제 키를 저장소에 커밋하지 마세요.
TOSS_CLIENT_KEY=test_gck_REPLACE_WITH_SHOP_KEY
TOSS_SECRET_KEY=test_gsk_REPLACE_WITH_MATCHING_SHOP_KEY
TOSS_MID=spacew90od
# 실제 상점 계약에 맞는 taxable / exempt / mixed
TOSS_TAX_MODE=
TOSS_PAYMENT_VARIANT=DEFAULT
TOSS_AGREEMENT_VARIANT=AGREEMENT
# openssl rand -base64 32 등으로 생성한 32바이트 암호화 키
ORDER_ENCRYPTION_KEY=
# 테스트 준비 완료 후 true. 실결제 키는 코드에서 차단합니다.
PAYMENTS_ENABLED=false
